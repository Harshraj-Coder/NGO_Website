generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Volunteer {
  id          Int     @default(autoincrement())
  email       String  @id
  username    String
  phoneNo     String
  password    String
  availability String @default("no") // "yes" or "no"
}

model Admin {
  id       Int    @default(autoincrement())
  email    String @id
  username String
  phoneNo  String
  password String
}